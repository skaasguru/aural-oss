# Everything through a Bifrost gateway (>= 2.4 for relays): Claude for text, AssemblyAI for speech.
# One Bifrost virtual key is the only credential Aural holds; provider keys stay in the gateway.
# Gateway side (see deploy/vip-dev/bifrost-seed.json):
#   - provider `anthropic`
#   - custom provider `assemblyai` (OpenAI base, base_url https://tts.us.assemblyai.com,
#     speech path /v1/openai/audio/speech)
#   - relay `assemblyai-stt` -> https://sync.assemblyai.com, route POST /v1/transcribe
#   - a virtual key allowed to use both providers and granted the relay

# Speech-to-text: AssemblyAI Sync API, one request per finished utterance, via the relay.
VOICE_ASR_PROVIDER=assemblyai
VOICE_STT_BASE_URL=http://bifrost:8080/relay/assemblyai-stt
VOICE_STT_API_KEY=REPLACE_WITH_BIFROST_VIRTUAL_KEY
VOICE_STT_MODEL=universal-3-6-pro
VOICE_STT_LANGUAGE=en

# Text-to-speech: AssemblyAI's OpenAI-compatible speech route. `pcm` is raw 24 kHz mono s16le,
# exactly what the browser plays, so nothing is transcoded.
VOICE_TTS_PROVIDER=openai-compatible
VOICE_TTS_BASE_URL=http://bifrost:8080/v1
VOICE_TTS_API_KEY=REPLACE_WITH_BIFROST_VIRTUAL_KEY
VOICE_TTS_MODEL=assemblyai/assemblyai-tts-en
VOICE_TTS_VOICE=aai-kyla
VOICE_TTS_FORMAT=pcm
VOICE_TTS_MAX_INPUT_CHARS=200

# Text LLMs (OpenAI-compatible chat completions; Bifrost translates to the Claude API):
OPENAI_API_KEY=REPLACE_WITH_BIFROST_VIRTUAL_KEY
OPENAI_BASE_URL=http://bifrost:8080/v1
LLM_CHAT_MODEL=anthropic/claude-haiku-5-5
LLM_GENERATOR_MODEL=anthropic/claude-haiku-5-5
LLM_REPORT_MODEL=anthropic/claude-sonnet-5-5
RELAY_LLM_PROVIDER=openai
RELAY_LLM_MODEL=anthropic/claude-haiku-5-5
RELAY_LLM_API_KEY=REPLACE_WITH_BIFROST_VIRTUAL_KEY
RELAY_LLM_BASE_URL=http://bifrost:8080/v1
