# Direct Groq Whisper STT + local Kokoro TTS. Placeholders only; never commit real keys.
# Server-side only: none of these may carry a NEXT_PUBLIC_ prefix.
VOICE_ASR_PROVIDER=openai-compatible
VOICE_STT_BASE_URL=https://api.groq.com/openai/v1
VOICE_STT_API_KEY=REPLACE_WITH_GROQ_KEY
VOICE_STT_MODEL=whisper-large-v3-turbo
VOICE_STT_SILENCE_MS=800

VOICE_TTS_PROVIDER=openai-compatible
# Kokoro-FastAPI serves /v1/audio/speech; from compose use http://kokoro:8880/v1
VOICE_TTS_BASE_URL=http://kokoro:8880/v1
VOICE_TTS_MODEL=kokoro
VOICE_TTS_VOICE=af_heart
VOICE_TTS_VOICE_ZH=zf_xiaobei
VOICE_TTS_FORMAT=wav

# The relay still needs an LLM for interviewer replies.
RELAY_LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
