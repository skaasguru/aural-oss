# Everything through a Bifrost gateway's OpenAI-compatible API. Bifrost is just transport:
# the base URL points at it (include /v1) and the model carries the provider prefix.
VOICE_ASR_PROVIDER=openai-compatible
VOICE_STT_BASE_URL=http://bifrost:8080/v1
VOICE_STT_API_KEY=REPLACE_IF_BIFROST_REQUIRES_ONE
VOICE_STT_MODEL=groq/whisper-large-v3-turbo

VOICE_TTS_PROVIDER=openai-compatible
VOICE_TTS_BASE_URL=http://bifrost:8080/v1
VOICE_TTS_API_KEY=REPLACE_IF_BIFROST_REQUIRES_ONE
VOICE_TTS_MODEL=groq/canopylabs/orpheus-v1-english
VOICE_TTS_VOICE=hannah
# Orpheus accepts at most 200 characters per request and returns WAV only: longer text is split
# at sentence boundaries, never truncated.
VOICE_TTS_MAX_INPUT_CHARS=200
VOICE_TTS_FORMAT=wav

# Text LLMs through the same gateway (OpenAI-compatible):
OPENAI_API_KEY=REPLACE_IF_BIFROST_REQUIRES_ONE
OPENAI_BASE_URL=http://bifrost:8080/v1
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_GENERATOR_MODEL=openai/gpt-4o-mini
LLM_REPORT_MODEL=openai/gpt-4o
RELAY_LLM_PROVIDER=openai
RELAY_LLM_MODEL=openai/gpt-4o-mini
RELAY_LLM_API_KEY=REPLACE_IF_BIFROST_REQUIRES_ONE
RELAY_LLM_BASE_URL=http://bifrost:8080/v1
