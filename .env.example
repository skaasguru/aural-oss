# ──────────────────────────────────────
# Supabase
# ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ──────────────────────────────────────
# App URL
# ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────
# LLM Providers
# ──────────────────────────────────────
# Configure at least one provider. Recommended OSS setup:
# - OPENAI_API_KEY for the main app features
# - GEMINI_API_KEY for relay summarization and as a low-latency fallback

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Google Gemini
GEMINI_API_KEY=

# Moonshot Kimi
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# MiniMax
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Optional: raises the rate limit for the browser-backed fallback used when a
# public JD page blocks normal server-side fetching (for example, HTTP 403).
JINA_READER_API_KEY=

# ──────────────────────────────────────
# Voice Relay
# ──────────────────────────────────────
VOICE_RELAY_PORT=8766
OPENAI_VOICE_RELAY_PORT=8767

# Browser-facing relay URLs. In production behind a reverse proxy, these can
# point to same-origin WebSocket paths such as /ws/voice and /ws/openai-voice.
NEXT_PUBLIC_VOICE_RELAY_URL=ws://localhost:8766
NEXT_PUBLIC_OPENAI_VOICE_RELAY_URL=ws://localhost:8767

# Primary relay preference: "auto" | "voice" | "openai"
# Recommended for best voice quality when Doubao credentials are configured.
NEXT_PUBLIC_VOICE_RELAY_PRIMARY=voice

# Transcription provider for the primary relay; Seed remains the default.
# Qwen changes recognition only; Doubao TTS and the relay LLM are still required.
# Options: seed | qwen | qwen-audio | openai-compatible (see docs/speech-providers.md).
VOICE_ASR_PROVIDER=seed
# Optional Qwen providers: qwen | qwen-audio. Use a key for dashscope.aliyuncs.com.
QWEN_ASR_API_KEY=
# Empty uses the provider default: 0.3 for qwen, 0.1 for qwen-audio.
# Valid range: -1 to 1. Higher thresholds suppress more noise and may miss quiet speech.
QWEN_ASR_NOISE_THRESHOLD=

# ──────────────────────────────────────
# Relay LLM
# ──────────────────────────────────────
# Used by the Volcengine voice relay for interviewer replies and context
# summarization. Defaults to Gemini and falls back to MiniMax when configured.
RELAY_LLM_PROVIDER=gemini
RELAY_LLM_MODEL=gemini-3.1-flash-lite
RELAY_LLM_TEMPERATURE=0
# Optional; falls back to GEMINI_API_KEY when RELAY_LLM_PROVIDER=gemini.
# RELAY_LLM_API_KEY=
# Only needed for OpenAI-compatible relay LLMs.
# RELAY_LLM_BASE_URL=
# RELAY_LLM_FALLBACK_MODEL=abab6.5s-chat
# RELAY_LLM_FALLBACK_BASE_URL=https://api.minimaxi.com/v1

# ──────────────────────────────────────
# Volcengine Doubao Voice Relay
# ──────────────────────────────────────
# Seed ASR requires DOUBAO_API_KEY; Qwen ASR uses QWEN_ASR_API_KEY instead.
# The primary relay also requires DOUBAO_APP_ID + DOUBAO_ACCESS_TOKEN for TTS.
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_VOICE_EN=en_female_dacey_uranus_bigtts
DOUBAO_VOICE_ZH=zh_female_shuangkuaisisi_uranus_bigtts
DOUBAO_TTS_SPEECH_RATE=1
DOUBAO_TTS_PCM_SAMPLE_LAYOUT=int16le

# Optional ASR timing overrides. The defaults are tuned for natural interview
# pauses and should work well for most deployments.
# DOUBAO_ASR_END_WINDOW_MS=800
# DOUBAO_ASR_FINAL_COALESCE_MS=1500
# DOUBAO_ASR_LONG_FINAL_COALESCE_MS=3000
# DOUBAO_ASR_SHORT_FINAL_COALESCE_MS=300
# DOUBAO_ASR_ACTIVE_SPEECH_HOLD_MS=600
# DOUBAO_ASR_PENDING_FINAL_QUIET_MS=1600
# DOUBAO_ASR_MAX_ACTIVE_SPEECH_HOLD_MS=60000

# ──────────────────────────────────────
# Azure OpenAI Realtime Voice Relay
# ──────────────────────────────────────
# Backup relay for environments without Doubao credentials.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-realtime-1.5
# AZURE_OPENAI_VOICE=ash

# ASR provider used by the Azure OpenAI relay: "openai" | "volc"
# Keep "openai" unless you want the Azure relay to use Doubao ASR.
# VOICE_ASR_PRIMARY=openai
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=whisper-1

# ──────────────────────────────────────
# Optional
# ──────────────────────────────────────
# LOG_LEVEL=info

# ──────────────────────────────────────
# Provider-agnostic speech (server-side only; never NEXT_PUBLIC_)
# ──────────────────────────────────────
# STT: VOICE_ASR_PROVIDER=openai-compatible uploads each locally-segmented utterance to
#   {VOICE_STT_BASE_URL}/audio/transcriptions (Groq Whisper, OpenAI, or a Bifrost gateway).
#   It is not native streaming: there are no partial transcripts.
# VOICE_STT_BASE_URL=https://api.groq.com/openai/v1
# VOICE_STT_API_KEY=
# VOICE_STT_MODEL=whisper-large-v3-turbo
# VOICE_STT_PROMPT=
# VOICE_STT_LANGUAGE=            # optional ISO code override (en, zh); default derives from the interview
# VOICE_STT_SILENCE_MS=800       # silence that ends an utterance (200-6000)
# VOICE_STT_MIN_SPEECH_MS=200
# VOICE_STT_PREROLL_MS=300
# VOICE_STT_MAX_UTTERANCE_MS=30000
# VOICE_STT_VAD_THRESHOLD=0.015  # RMS 0.001-0.5; raise in noisy rooms
# VOICE_STT_TIMEOUT_MS=20000
# VOICE_STT_MAX_QUEUE=4
# VOICE_STT_MAX_RETRIES=1
# VOICE_STT_FAILURE_THRESHOLD=3
# VOICE_STT_COOLDOWN_MS=15000
# VOICE_STT_MAX_RESPONSE_BYTES=1048576      # max bytes read from one provider response (streamed, then cancelled)
# VOICE_STT_MAX_TRANSCRIPT_SEGMENTS=200     # max transcript segments per STT session
# VOICE_STT_MAX_TRANSCRIPT_CHARS=20000      # max cumulative transcript characters per STT session

# TTS: doubao (default, uses DOUBAO_*) | openai-compatible ({VOICE_TTS_BASE_URL}/audio/speech)
# VOICE_TTS_PROVIDER=doubao
# VOICE_TTS_BASE_URL=http://kokoro:8880/v1
# VOICE_TTS_API_KEY=
# VOICE_TTS_MODEL=kokoro
# VOICE_TTS_VOICE=af_heart
# VOICE_TTS_VOICE_EN=
# VOICE_TTS_VOICE_ZH=
# VOICE_TTS_FORMAT=wav           # wav | pcm | mp3 | opus | aac | flac (compressed ones need ffmpeg)
# VOICE_TTS_PCM_SAMPLE_RATE=24000
# VOICE_TTS_MAX_INPUT_CHARS=0    # 0 = unlimited; Groq Orpheus: 200 (text is split, never truncated)
# VOICE_TTS_SPEED=
# VOICE_TTS_TIMEOUT_MS=30000
# VOICE_TTS_MAX_AUDIO_BYTES=33554432        # one provider response
# VOICE_TTS_MAX_TOTAL_AUDIO_BYTES=33554432  # all segments of one synthesis, after normalization to 24 kHz s16le
# VOICE_TTS_MAX_SEGMENTS=40
# VOICE_TTS_FFMPEG_PATH=ffmpeg

# Text-LLM model ids (default to the built-in per-provider models when unset)
# LLM_CHAT_MODEL=
# LLM_GENERATOR_MODEL=
# LLM_REPORT_MODEL=
